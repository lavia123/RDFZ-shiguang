{
  "name": "rdfz-shiguang",
  "version": "0.1.0",
  "private": true,
  "description": "拾光校园失物招领",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.1.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.78.0",
    "multer": "^2.5.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts --local-dev",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.mjs --production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.json *.ts README.md",
    "test": "vitest run",
    "test:ui": "playwright test",
    "import:data": "tsx src/server/import-data.ts",
    "test:lesson": "NEXT_PUBLIC_BASE_PATH=/lesson-app/l_runtime_test pnpm build && node --test tests/lesson-runtime.mjs",
    "test:development": "node --test tests/development-runtime.mjs"
  }
}
